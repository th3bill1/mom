{
  "name": "th3bill",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-data": "node -e \"const fs=require('node:fs'); fs.rmSync('public/data',{recursive:true,force:true}); fs.cpSync('data','public/data',{recursive:true});\"",
    "build": "npm run sync-data && node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && react-router build",
    "dev": "react-router dev",
    "deploy": "npm run build && wrangler deploy",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "7.13.1",
    "@react-router/serve": "7.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.31",
    "katex": "^0.16.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-router": "7.13.1",
    "tailwind-merge": "^3.5.0",
    "wrangler": "^4.67.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.13.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
